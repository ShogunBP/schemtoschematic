# ============================================
# Backend (API)
# ============================================

# Ambiente: development ou production
NODE_ENV=development

# Porta da API (padrÃ£o: 3002)
PORT=3002

# Chave secreta para autenticaÃ§Ã£o (OBRIGATÃ“RIO em produÃ§Ã£o)
# Gere uma chave forte e segura, nunca compartilhe!
SECRET_KEY=

# URL do frontend para configuraÃ§Ã£o de CORS
# Exemplo produÃ§Ã£o: http://seu-dominio.com:8081
# Exemplo desenvolvimento: http://localhost:8081
FRONTEND_URL=http://localhost:8081

# ForÃ§ar autenticaÃ§Ã£o mesmo em desenvolvimento (opcional)
# true ou false
REQUIRE_AUTH=false

# ============================================
# Frontend (UI)
# ============================================

# URL da API para o frontend
# Em produÃ§Ã£o com proxy nginx: /convert
# Em desenvolvimento: http://localhost:3002
VITE_API_URL=http://localhost:3002

# Porta do Vite em desenvolvimento (opcional)
VITE_PORT=8081

# ============================================
# Docker / Deploy
# ============================================

# DiretÃ³rio base para dados persistentes (opcional)
# Ajuste conforme sua estrutura de diretÃ³rios
PROJECT_DATA_DIR=./data

# DiretÃ³rio do projeto (usado no deploy.sh)
# PadrÃ£o: diretÃ³rio atual
PROJECT_DIR=

# ============================================
# Build (gerado automaticamente)
# ============================================

# Timestamp do build (gerado automaticamente durante build)
BUILD_TIMESTAMP=

# VersÃ£o do build (gerado automaticamente - Git commit hash)
BUILD_VERSION=
